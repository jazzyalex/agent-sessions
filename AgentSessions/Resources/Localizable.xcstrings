    "%lld sessions found": {
      "comment": "Session discovery count. Use the singular form for one session.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld session found"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sessions found"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "找到 %lld 个会话"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "找到 %lld 个会话"
                }
              }
            }
          }
        }
      }
    },
    "%lld%% remaining, burning to empty in about %@, reset in %@.": {
      "comment": "Complete notification body for a usage window with a burn projection and reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, burning to empty in about %2$@, reset in %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %1$lld%%，按当前速度约 %2$@后用尽，将于 %3$@后重置。"
          }
        }
      }
    },
    "%lld%% remaining, burning to empty in about %@.": {
      "comment": "Complete notification body for a usage window with a burn projection and no reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, burning to empty in about %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %1$lld%%，按当前速度约 %2$@后用尽。"
          }
        }
      }
    },
    "%lld%% remaining, for the 5h limit, reset in %@.": {
      "comment": "Complete notification body for a five-hour usage window with a reset estimate and no burn projection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, for the 5h limit, reset in %2$@."
