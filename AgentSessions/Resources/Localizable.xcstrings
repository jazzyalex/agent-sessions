    "When enabled, Auto mode falls back to the claude.ai Web API before tmux. Uses a session cookie you paste below — no Full Disk Access needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Auto mode falls back to the claude.ai Web API before tmux. Uses a session cookie you paste below — no Full Disk Access needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，自动模式会先回退到 claude.ai Web API，再尝试 tmux。它会使用你在下方粘贴的会话 Cookie，无需“完全磁盘访问权限”。"
          }
        }
      }
    },
    "When enabled, falls back to opencode --continue if --resume is unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, falls back to opencode --continue if --resume is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，如果 --resume 不可用，则回退到 opencode --continue"
          }
        }
      }
    },
    "When enabled, global search continues scanning large tool outputs in the background after showing indexed results. This can be noticeably slower on large histories.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, global search continues scanning large tool outputs in the background after showing indexed results. This can be noticeably slower on large histories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，全局搜索会在显示索引结果后继续在后台扫描大型工具输出。对于大量历史记录，这可能明显变慢。"
          }
        }
      }
    },
    "When enabled, recognized Codex internal review payloads render as summary cards instead of raw JSON.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, recognized Codex internal review payloads render as summary cards instead of raw JSON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，识别出的 Codex 内部审阅数据会呈现为摘要卡片，而不是原始 JSON。"
          }
        }
      }
    },
    "When enabled, removing a session from Saved also deletes the local archive copy. By default, removing from Saved is non-destructive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, removing a session from Saved also deletes the local archive copy. By default, removing from Saved is non-destructive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，从“已保存”中移除会话时也会删除本地归档副本。默认情况下，从“已保存”中移除不会删除文件。"
          }
        }
      }
    },
    "When enabled, saving a session also archives its source files into Agent Sessions storage so it cannot disappear when the upstream CLI prunes history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, saving a session also archives its source files into Agent Sessions storage so it cannot disappear when the upstream CLI prunes history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，保存会话时还会将其源文件归档到 Agent Sessions 存储中，防止上游 CLI 清理历史记录时导致会话消失。"
          }
        }
      }
    },
    "When opening a session without a search query, choose which prompt to jump to in Session view": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When opening a session without a search query, choose which prompt to jump to in Session view"
