          }
        }
      }
    },
    "Used for both the copied resume command and Resume in Terminal. Devin resumes by session id (`--resume`), falling back to `--continue` for the most recent conversation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for both the copied resume command and Resume in Terminal. Devin resumes by session id (`--resume`), falling back to `--continue` for the most recent conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时用于复制的继续命令和“在 Terminal 中继续”。Devin 通过会话 ID（`--resume`）继续；若不可用，则使用 `--continue` 继续最近的对话。"
          }
        }
      }
    },
    "Used for both the copied resume command and Resume in Terminal. Grok resumes by session id (`--resume`), falling back to `--continue` for the working directory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for both the copied resume command and Resume in Terminal. Grok resumes by session id (`--resume`), falling back to `--continue` for the working directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时用于复制的继续命令和“在 Terminal 中继续”。Grok 通过会话 ID（`--resume`）继续；若不可用，则对工作目录使用 `--continue`。"
          }
        }
      }
    },
    "Used for both the copied resume command and Resume in Terminal. Kimi resumes by session id (`--session`), falling back to `--continue` for the working directory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for both the copied resume command and Resume in Terminal. Kimi resumes by session id (`--session`), falling back to `--continue` for the working directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时用于复制的继续命令和“在 Terminal 中继续”。Kimi 通过会话 ID（`--session`）继续；若不可用，则对工作目录使用 `--continue`。"
          }
        }
      }
    },
    "Used for both the copied resume command and Resume in Terminal. fx resumes by session id (`--resume`), falling back to `--continue` for the latest session in the workspace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
