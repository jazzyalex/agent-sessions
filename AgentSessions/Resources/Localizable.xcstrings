{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ limit is exhausted": {
      "comment": "Notification title shown when a provider usage window is exhausted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ limit is exhausted"
          }
        }
      }
    },
    "%@ %@ usage is burning fast": {
      "comment": "Notification title shown when a provider usage window is projected to exhaust soon.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ usage is burning fast"
          }
        }
      }
    },
    "%@ %@ usage is low": {
      "comment": "Notification title shown when a provider usage window is approaching its configured alert threshold.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ usage is low"
          }
        }
      }
    },
    "%@ 5h is back again": {
      "comment": "Notification title shown when a provider five-hour usage window resets.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 5h is back again"
          }
        }
      }
    },
    "%lld%% remaining, burning to empty in about %@, reset in %@.": {
      "comment": "Complete notification body for a usage window with a burn projection and reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, burning to empty in about %2$@, reset in %3$@."
          }
        }
      }
    },
    "%lld%% remaining, burning to empty in about %@.": {
      "comment": "Complete notification body for a usage window with a burn projection and no reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, burning to empty in about %2$@."
          }
        }
      }
    },
    "%lld%% remaining, for the %@ limit, reset in %@.": {
      "comment": "Complete notification body for a usage window with a reset estimate and no burn projection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, for the %2$@ limit, reset in %3$@."
          }
        }
      }
    },
    "%lld%% remaining, for the %@ limit.": {
      "comment": "Complete notification body for a usage window with no projection or reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% remaining, for the %2$@ limit."
          }
        }
      }
    },
    "0% remaining.": {
      "comment": "Notification body shown for an exhausted usage window without a reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% remaining."
          }
        }
      }
    },
    "0%% remaining. Reset in %@.": {
      "comment": "Notification body shown for an exhausted usage window with a reset estimate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0%% remaining. Reset in %@."
          }
        }
      }
    },
