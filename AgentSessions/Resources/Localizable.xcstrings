          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时用于复制的继续命令和“在 Terminal 中继续”。fx 通过会话 ID（`--resume`）继续；若不可用，则使用 `--continue` 继续工作区中的最新会话。"
          }
        }
