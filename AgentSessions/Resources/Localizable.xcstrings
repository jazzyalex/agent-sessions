{
  "sourceLanguage": "en",
  "strings": {
    "%@ 5h is back again": {
      "comment": "Notification title shown when a provider five-hour usage window resets.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 5h is back again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 5h 额度已恢复"
          }
        }
      }
    },
    "%@ 5h limit is exhausted": {
      "comment": "Notification title for an exhausted provider five-hour usage window.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 5h limit is exhausted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 5h 额度已用尽"
          }
        }
      }
    },
    "%@ 5h usage is burning fast": {
      "comment": "Notification title for a provider five-hour usage window projected to exhaust soon.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 5h usage is burning fast"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 5h 额度消耗过快"
          }
        }
      }
    },
    "%@ 5h usage is low": {
