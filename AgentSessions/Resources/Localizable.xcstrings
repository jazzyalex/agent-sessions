    "Quota Meter run-out tokens use fresh 5h usage velocity and can show longer before-reset ETAs than notification alerts. This display setting is independent of notification delivery.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota Meter run-out tokens use fresh 5h usage velocity and can show longer before-reset ETAs than notification alerts. This display setting is independent of notification delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额度监视器的额度耗尽倒计时基于最新的 5 小时用量速率，因此显示的重置前预计时间可能比通知提醒更长。此显示设置与通知发送相互独立。"
          }
        }
      }
    },
