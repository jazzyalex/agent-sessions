        }
      }
    },
    "The menu bar item shows active and waiting sessions first. Usage controls and reset details appear below when usage tracking is enabled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar item shows active and waiting sessions first. Usage controls and reset details appear below when usage tracking is enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏项目会优先显示活跃和等待中的会话。启用用量跟踪后，下方会显示用量控制项和重置详情。"
          }
        }
      }
    },
    "The provider asked Agent Sessions to pause usage requests. Tracking will retry automatically; hiding affects only Quota Meter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider asked Agent Sessions to pause usage requests. Tracking will retry automatically; hiding affects only Quota Meter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商要求 Agent Sessions 暂停用量请求。跟踪功能会自动重试；隐藏仅影响额度监视器。"
          }
        }
      }
    },
    "The right CLI wins": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right CLI wins"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用正确的 CLI"
          }
        }
      }
    },
    "The weekly Session Runway used to divide everything burned since the weekly reset by the time elapsed, so one heavy day set the displayed pace for days after. It now measures the burn between recent quota readings, and shows token throughput until it has a real reading to attribute.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weekly Session Runway used to divide everything burned since the weekly reset by the time elapsed, so one heavy day set the displayed pace for days after. It now measures the burn between recent quota readings, and shows token throughput until it has a real reading to attribute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去，每周会话续航会用周重置后的全部消耗除以经过时间，因此某一天的高用量会影响之后多天显示的消耗速度。现在它会测量最近几次额度读数之间的消耗，并在获得可归因的实际读数前显示 token 吞吐量。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
