    "Agent Sessions adds new agents from user contributions — a pull request, your coding agent working from our brief, or a sanitized sample. Never share real transcripts, keys, or private paths.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Sessions adds new agents from user contributions — a pull request, your coding agent working from our brief, or a sanitized sample. Never share real transcripts, keys, or private paths."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Sessions 通过用户贡献添加新智能体，包括 Pull Request、让你的编码智能体按照我们的说明工作，或提供经过脱敏的样本。切勿分享真实对话记录、密钥或私有路径。"
          }
        }
      }
    },
    "Agent Sessions can combine multiple local agent histories.": {
