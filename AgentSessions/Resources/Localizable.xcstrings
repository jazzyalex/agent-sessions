          }
        }
      }
    },
    "After a saved session stops changing upstream for this long, Agent Sessions stops syncing the local copy. If it changes later, syncing resumes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a saved session stops changing upstream for this long, Agent Sessions stops syncing the local copy. If it changes later, syncing resumes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的会话在上游停止变化达到此时长后，Agent Sessions 将停止同步其本地副本。如果之后再次发生变化，同步将恢复。"
          }
        }
      }
    },
    "After each status probe, only Codex probe sessions are deleted once safety checks verify they were created by Agent Sessions.": {
      "localizations": {
        "en": {
