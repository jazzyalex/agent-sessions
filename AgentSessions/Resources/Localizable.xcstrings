    "Qwen Code joins the lineup, and agents are now plug-in adapters — adding the one you use is a documented recipe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen Code joins the lineup, and agents are now plug-in adapters — adding the one you use is a documented recipe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现已支持 Qwen Code，智能体也已改为插件式适配器——按照文档即可添加你使用的智能体。"
          }
        }
      }
    },
    "Qwen Code stores one session-ID-named JSONL transcript per session below each project's chats directory. Override this only for a relocated QWEN_HOME or copied projects root. A copied root not named projects remains browse-only because the CLI cannot resolve it for resume.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen Code stores one session-ID-named JSONL transcript per session below each project's chats directory. Override this only for a relocated QWEN_HOME or copied projects root. A copied root not named projects remains browse-only because the CLI cannot resolve it for resume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen Code 会在每个项目的 chats 目录下，为每个会话保存一份以会话 ID 命名的 JSONL 对话记录。仅当 QWEN_HOME 已迁移或复制了 projects 根目录时才覆盖此设置。如果复制的根目录不名为 projects，则只能浏览，因为 CLI 无法解析它以继续会话。"
          }
        }
      }
    },
    "Qwen Code was not found. Ensure `qwen` is on PATH.": {
      "localizations": {
